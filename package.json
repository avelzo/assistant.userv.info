    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/ui": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "jsdom": "^30.1.3",
    "playwright": "^1.60.0",
    "postcss": "8.5.32",
    "prisma": "^6.12.0",
