  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.15",
    "jspdf": "^4.2.1",
    "mongodb": "^7.8.0",
    "next": "16.4.4",
    "nodemailer": "10.3.1",
    "openai": "^7.47.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.1.0",
    "zod": "^4.4.3"
